{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sampleur",
  "version": "2.0.0",
  "identifier": "fr.sampleur.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Sampleur V2",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["sampleur2"],
        "name": "Sampleur Preset",
        "description": "Sampleur V2 Preset File",
        "mimeType": "application/x-sampleur2"
      }
    ]
  }
}
